# Template de nginx: el entrypoint oficial de la imagen nginx ejecuta envsubst
# sobre /etc/nginx/templates/*.template y genera /etc/nginx/conf.d/default.conf.
# Solo sustituye variables definidas en el entorno (DESPACHOS_URL, VENTAS_URL);
# las variables propias de nginx ($host, $remote_addr) quedan intactas.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/v1/despachos {
        proxy_pass ${DESPACHOS_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1/ventas {
        proxy_pass ${VENTAS_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
